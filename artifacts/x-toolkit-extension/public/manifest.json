{
  "manifest_version": 3,
  "name": "X Toolkit – Temp Email, Temp Gmail & OTP Detector",
  "short_name": "X Toolkit",
  "version": "1.1.0",
  "description": "Instant disposable inbox, temp Gmail address & automatic OTP detection in your Chrome toolbar. Free, no signup, auto-refresh every 15s.",
  "homepage_url": "https://xtoolkit.live/chrome-extension",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "X Toolkit – Temp Email, Temp Gmail & OTP Detector"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "notifications", "alarms", "contextMenus", "clipboardWrite"],
  "host_permissions": [
    "https://xtoolkit.live/*",
    "https://api.guerrillamail.com/*",
    "https://www.mail.gw/*",
    "https://maildrop.cc/*"
  ],
  "commands": {
    "copy-active-email": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Copy active temp email address to clipboard"
    }
  }
}
